                link.click();
            }

            clearDashboardData() {
                if (confirm('هل أنت متأكد من مسح كل سجلات الطلاب المحفوظة على هذا الجهاز؟ لا يمكن التراجع عن هذا الإجراء.')) {
                    localStorage.removeItem('examSubmissions');
                    localStorage.removeItem('examLockInfo');
                    this.renderDashboard();
                }
            }
        }

        let app;
        window.addEventListener('DOMContentLoaded', () => {
            app = new ExamController();
            app.refreshHomeLockState();
        });
    </script>
</body>
</html>
