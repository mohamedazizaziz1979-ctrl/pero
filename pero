                this.applyStoredTheme();
            }

            getExamLockInfo() {
                try {
                    const raw = localStorage.getItem('examLockInfo');
                    return raw ? JSON.parse(raw) : null;
                } catch (e) {
                    return null;
                }
            }

            refreshHomeLockState() {
                const lockInfo = this.getExamLockInfo();
                const startPanel = document.getElementById('home-start-panel');
                const lockedPanel = document.getElementById('home-locked-panel');
                if (!startPanel || !lockedPanel) return;

                if (lockInfo) {
                    startPanel.classList.add('hidden');
                    lockedPanel.classList.remove('hidden');
                    const infoEl = document.getElementById('locked-panel-info');
                    if (infoEl) {
                        infoEl.textContent = `آخر محاولة: ${lockInfo.name} - الدرجة: ${lockInfo.score} / 30 - بتاريخ ${lockInfo.date}`;
                    }
                } else {
                    startPanel.classList.remove('hidden');
                    lockedPanel.classList.add('hidden');
                }
            }

            unlockWithTeacherPassword() {
                const entered = prompt('أدخل كلمة السر التي أعطاك إياها المعلم للسماح بمحاولة جديدة:');
                if (entered === null) return;
                if (entered.trim() !== TEACHER_DASHBOARD_PASSWORD) {
                    alert('كلمة السر غير صحيحة.');
                    return;
                }
                localStorage.removeItem('examLockInfo');
                this.refreshHomeLockState();
                alert('تم فتح الامتحان لك. يمكنك الآن كتابة اسمك والبدء.');
            }

            countArabicNameUnits(name) {
                const words = name.split(' ').filter(Boolean);
                // كلمات لا تُعتبر اسمًا مستقلاً بذاتها، بل جزء من الاسم المركب التالي لها
                const mergePrefixes = ['عبد', 'عبدال', 'أبو', 'ابو', 'أبي', 'ابي', 'ابن', 'بن', 'أم', 'ام'];
                const units = [];
                for (let i = 0; i < words.length; i++) {
                    if (mergePrefixes.includes(words[i]) && i + 1 < words.length) {
                        units.push(words[i] + ' ' + words[i + 1]);
                        i++; // تخطي الكلمة التالية لأنها اندمجت بالفعل
                    } else {
                        units.push(words[i]);
                    }
                }
                return units;
            }

            startInteractiveExam() {
                if (this.getExamLockInfo()) {
                    alert('هذا الجهاز قام بتأدية الامتحان من قبل. تواصل مع المعلم للحصول على إذن ومحاولة جديدة.');
                    this.refreshHomeLockState();
                    return;
                }

                const nameInput = document.getElementById('student-name-input');
                const name = nameInput ? nameInput.value.trim().replace(/\s+/g, ' ') : '';
                const nameParts = name ? this.countArabicNameUnits(name) : [];

                if (!name) {
                    alert('من فضلك اكتب اسمك ثلاثيًا أولاً قبل بدء الامتحان.');
                    if (nameInput) nameInput.focus();
                    return;
                }
                if (nameParts.length < 3) {
                    alert('من فضلك اكتب اسمك كاملاً ثلاثيًا (مثال: محمد أحمد علي) قبل بدء الامتحان. لاحظ أن الأسماء المركبة مثل "عبد الله" أو "أبو بكر" تُحسب اسمًا واحدًا فقط.');
                    if (nameInput) nameInput.focus();
                    return;
                }
                this.studentName = name;

                document.getElementById('view-home').classList.add('hidden');
                document.getElementById('view-results').classList.add('hidden');
                document.getElementById('view-print-booklet').classList.add('hidden');
                document.getElementById('view-teacher-dashboard').classList.add('hidden');
                document.getElementById('view-exam').classList.remove('hidden');

                this.startTimer();
                window.scrollTo({ top: 0, behavior: 'smooth' });
