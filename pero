            startTimer() {
                if (this.timerInterval) clearInterval(this.timerInterval);

                const updateDisplay = () => {
                    const mins = Math.floor(this.secondsLeft / 60);
                    const secs = this.secondsLeft % 60;
                    document.getElementById('timer-display').textContent = 
                        `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

                    if (this.secondsLeft <= 0) {
                        clearInterval(this.timerInterval);
                        alert('انتهى الوقت المحدد للامتحان! جاري رصد النتيجة تلقائياً...');
                        this.submitExam();
                    } else {
                        this.secondsLeft--;
                    }
                };

                updateDisplay();
                this.timerInterval = setInterval(updateDisplay, 1000);
            }

            updateWordCount() {
                const text = document.getElementById('paragraph_input').value.trim();
                const words = text ? text.split(/\s+/).length : 0;
                document.getElementById('word-count-num').textContent = words;
            }

            submitExam() {
                if (this.timerInterval) clearInterval(this.timerInterval);

                let objectiveScore = 0; // Out of 10
                let compScore = 0; // Out of 6
                let storyScore = 0; // Out of 8
                let writingScore = 0; // Out of 6

                // 1. Vocabulary MCQs (4 items)
                ['mcq_1', 'mcq_2', 'mcq_3', 'mcq_4'].forEach(name => {
                    const selected = document.querySelector(`input[name="${name}"]:checked`);
                    if (selected && selected.value === CORRECT_ANSWERS[name]) {
                        objectiveScore += 1;
                    }
                });

                // 2. Complete Gaps (3 items)
                ['gap_1', 'gap_2', 'gap_3'].forEach(id => {
                    const val = document.getElementById(id).value;
                    if (val === CORRECT_ANSWERS[id]) {
                        objectiveScore += 1;
                    }
                });

                // 3. Reading MCQs (3 items = 3 marks)
                ['comp_mcq_1', 'comp_mcq_2', 'comp_mcq_3'].forEach(name => {
                    const selected = document.querySelector(`input[name="${name}"]:checked`);
                    if (selected && selected.value === CORRECT_ANSWERS[name]) {
                        compScore += 1;
                    }
                });

                // 3. Reading Open questions (3 items = 3 marks if attempted)
                ['comp_open_1', 'comp_open_2', 'comp_open_3'].forEach(id => {
                    const val = document.getElementById(id).value.trim();
                    if (val.length >= 3) {
                        compScore += 1;
                    }
                });

                // 4. Story MCQs (4 items = 4 marks)
                ['story_mcq_1', 'story_mcq_2', 'story_mcq_3', 'story_mcq_4'].forEach(name => {
                    const selected = document.querySelector(`input[name="${name}"]:checked`);
                    if (selected && selected.value === CORRECT_ANSWERS[name]) {
                        storyScore += 1;
                    }
                });

                // 4. Story Open (2 items = 2 marks)
                ['story_open_1', 'story_open_2'].forEach(id => {
                    const val = document.getElementById(id).value.trim();
                    if (val.length >= 3) {
                        storyScore += 1;
                    }
                });

                // 5 & 6. Rewrite and Grammar (3 + 3 = 6 marks)
                ['rewrite_1', 'rewrite_2', 'rewrite_3'].forEach(id => {
                    const val = document.getElementById(id).value.trim();
                    if (val.length >= 4) {
                        storyScore += 0.66; // Total ~2
                    }
                });

                ['correct_1', 'correct_2', 'correct_3'].forEach(id => {
                    const val = document.getElementById(id).value.trim().toLowerCase();
                    const target = CORRECT_ANSWERS[id];
                    if (val.includes(target) || (id === 'correct_3' && (val.includes('encouraged')))) {
                        objectiveScore += 1;
                    }
                });

                // 7. Dialogue & Paragraph
                let dScore = 0;
                ['dialogue_1', 'dialogue_2', 'dialogue_3', 'dialogue_4'].forEach(id => {
                    const val = document.getElementById(id).value.trim();
                    if (val.length >= 2) dScore += 0.5;
                });

                const essayText = document.getElementById('paragraph_input').value.trim();
                const wordCount = essayText ? essayText.split(/\s+/).length : 0;
                let essayScore = Math.min(3, Math.round((wordCount / 110) * 3));

                writingScore = Math.min(6, dScore + essayScore + 1);

                // Total Final Score
                const totalScore = Math.min(30, Math.round(objectiveScore + compScore + storyScore + writingScore));

                // Render Results
                document.getElementById('view-exam').classList.add('hidden');
                document.getElementById('view-results').classList.remove('hidden');

                document.getElementById('final-score-pct').textContent = `${totalScore} / 30`;
                document.getElementById('score-obj').textContent = `${Math.min(10, Math.round(objectiveScore))} / 10`;
                document.getElementById('score-comp').textContent = `${Math.min(6, Math.round(compScore))} / 6`;
                document.getElementById('score-story').textContent = `${Math.min(8, Math.round(storyScore))} / 8`;
                document.getElementById('score-write').textContent = `${Math.min(6, Math.round(writingScore))} / 6`;

                const msgElement = document.getElementById('score-message');
                if (totalScore >= 26) {
                    msgElement.textContent = 'أداء ممتاز بامتياز! أظهرت إتقاناً تاماً لمفردات وقواعد الوحدة الأولى.';
                    if (typeof confetti === 'function') {
                        confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
                    }
                } else if (totalScore >= 20) {
                    msgElement.textContent = 'نتيجة جيدة جداً! اجتزت معظم أجزاء الامتحان بنجاح.';
                } else {
                    msgElement.textContent = 'تحتاج إلى إعادة مراجعة كلمات وقواعد الوحدة الأولى والمحاولة مرة أخرى.';
                }

                this.renderDetailedResults();
                this.lastTotalScore = totalScore;
                this.saveSubmissionRecord(totalScore);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

